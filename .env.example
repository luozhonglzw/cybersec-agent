# CyberSec Agent - Environment Variables
# 使用方法:复制本文件为 .env 并填入真实值。
# .env 已被 .gitignore 排除,永远不会进入 Git。

# ---------- LLM(OpenAI-compatible API)----------
# LLM_PROVIDER 只是一个标签(用于日志),业务代码不依赖具体厂商。
# 常见组合示例(把 LLM_API_KEY 换成你自己的 key):
#
#   DeepSeek:
#     LLM_PROVIDER=deepseek
#     LLM_MODEL=deepseek-chat
#     LLM_BASE_URL=https://api.deepseek.com
#     LLM_API_KEY=sk-xxxx
#
#   通义千问:
#     LLM_PROVIDER=qwen
#     LLM_MODEL=qwen-plus
#     LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#     LLM_API_KEY=sk-xxxx
#
#   OpenAI:
#     LLM_PROVIDER=openai
#     LLM_MODEL=gpt-4o-mini
#     LLM_BASE_URL=(留空,使用 SDK 默认地址)
#     LLM_API_KEY=sk-xxxx

LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
